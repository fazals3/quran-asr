# macOS (Apple Silicon) native configuration.
# Copy to `.env.mac` and edit if needed:  cp .env.mac.example .env.mac
# All paths default to the repo checkout, so usually you can leave this as-is.

# Shared secret between the Rust API and the Swift transcriber. The browser demo
# uses the public /demo/* routes and does NOT need this.
API_KEY=localdev

# Enable the /demo/* routes so the bundled web demo works without an API key.
DEMO_ENABLED=true

# Swift transcriber (WhisperKit / CoreML).
TRANSCRIBER_PORT=9000
LANGUAGE=ar
WORD_TIMESTAMPS=true

# Alignment (pure-Rust at runtime; uses the bundled v2 assets).
AYAH_ALIGN_MODE=v2

# Overrides (optional) — the run script fills these in from the repo path by default:
# DATA_DIR=/abs/path/to/repo/data
# QURAN_DB_PATH=/abs/path/to/repo/data/quran.db
# AYAH_ALIGN_V2_ASSETS_DIR=/abs/path/to/repo/data/alignment
# TRANSCRIBER_URLS=http://127.0.0.1:9000
# MODEL_DIR=/abs/path/to/repo/mac/models/ultra-fast-tarteel-coreml
# TOKENIZER_DIR=/abs/path/to/repo/mac/models/whisper-base-tokenizer
