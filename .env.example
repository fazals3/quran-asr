# Example config for `quran-asr/` (no secrets).
#
# Copy to `.env` and adjust. Keep `.env` out of git.

TAILSCALE_IP=127.0.0.1
API_KEY=change_me
RUST_API_PORT=8001
RUST_API_LOCAL_PORT=8004

# If `false` (recommended behind Cloudflare), a valid `API_KEY` is sufficient even if the client IP
# is not in `ALLOW_CIDRS` (Cloudflare requests come from Cloudflare IPs).
ENFORCE_ALLOW_CIDRS_WITH_API_KEY=false

# Public streaming auth (Option B refresh):
# - iOS connects to inference WS with a short-lived stream JWT minted by the gateway.
# - The token is session-scoped via `sid` claim and admin-only via `role=admin`.
STREAM_JWT_SECRET=change_me_stream_jwt_secret
STREAM_JWT_AUDIENCE=inference_stream
STREAM_AUTH_GRACE_S=10
STREAM_NO_AUDIO_TIMEOUT_S=30
STREAM_SILENCE_DBFS_THRESHOLD=-45
STREAM_SILENCE_SKIP_AFTER_S=1.2
STREAM_SILENCE_TIMEOUT_S=60
STREAM_TAIL_CONTEXT_S=4.0
STREAM_FULL_REFRESH_EVERY_S=60.0
# Stop a session whose client never connects the WebSocket after this many seconds.
STREAM_CONNECT_TIMEOUT_S=30
# How often the background reaper drops stopped streaming sessions from memory.
STREAM_SESSION_REAPER_INTERVAL_S=10

MAX_QUEUE_LENGTH=32
MAX_UPLOAD_BYTES=209715200
WORKER_CONCURRENCY=2

# Auto-clean `/data/jobs/<job_id>` directories.
# Completed/failed in-memory jobs are deleted after `JOB_RETENTION_S`.
# Leftover job dirs from previous API runs are deleted based on directory mtime.
JOB_CLEANUP_ENABLED=true
JOB_RETENTION_S=86400
JOB_CLEANUP_INTERVAL_S=3600
JOB_CLEANUP_STARTUP=true
JOB_CLEANUP_MAX_DELETE_PER_RUN=200

# Rust-side global GPU concurrency cap across all transcriber instances + streaming.
# On a single 8GB GPU, `2` is usually the best throughput/latency tradeoff.
RUST_TRANSCRIBE_MAX_INFLIGHT=2

# ASR model: NVIDIA NeMo FastConformer hybrid RNNT/CTC checkpoint fine-tuned on Quran recitation.
# The `.nemo` file is downloaded from Hugging Face into `HF_HOME` (/data/hf) on first start.
# Set `MODEL_PATH` to a local `.nemo` file (inside the container, e.g. /data/models/fastconformer-quran.nemo)
# to skip the download.
MODEL_ID=Muno459/fastconformer-quran
MODEL_PATH=
MODEL_REVISION=
LANGUAGE=ar
DEVICE=cuda
# `ctc` (default) gives frame-accurate word timestamps; `rnnt` uses the transducer head.
DECODER_TYPE=ctc
# Attach a per-word confidence (`probability`) from NeMo's max-prob estimator.
WORD_CONFIDENCE=true

# Long audio is split at detected silences into chunks of at most `CHUNK_MAX_S` seconds.
# When no silence is found, chunks are hard-split with `CHUNK_OVERLAP_S` seconds of overlap.
CHUNK_MAX_S=15
CHUNK_OVERLAP_S=3.0
CHUNK_SILENCE_NOISE_DB=-32
CHUNK_SILENCE_MIN_S=0.35
# Words separated by more than this pause start a new output segment.
SEGMENT_GAP_S=1.0

# Throughput tuning:
# - `BATCH_SIZE` is how many audio chunks are decoded per forward pass.
# - `BATCH_SIZE_CAP` is a hard ceiling for per-request overrides; on CUDA OOM it ratchets down automatically.
BATCH_SIZE=8
BATCH_SIZE_CAP=32
MAX_CONCURRENT_TRANSCRIBES=1


EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cuda
WARM_EMBEDDER=false

AYAH_ALIGN_MODE=v2
AYAH_ALIGN_V2_ASSETS_DIR=/data/alignment/v2
AYAH_WORD_TIME_UPGRADE=smooth
AYAH_ALIGN_V2_REF_DEL_COST_CAP=0.75
AYAH_ALIGN_V2_OBS_INS_COST_CAP=

QURAN_DB_PATH=/data/quran.db
GUESS_TOP_K=5
GUESS_PER_SURAH_TOP_N=3
GUESS_QUERY_OPERATOR=OR
GUESS_RANK_MODE=sum_top_score
GUESS_MAX_QUERY_TOKENS=24
GUESS_MAX_HITS=800

# Demo mode (HuggingFace Spaces-style public demo).
# Disabled by default. Set to `true` to mount /demo/* routes that bypass API key auth.
DEMO_ENABLED=false
# Comma-separated origins for CORS. Use `*` to allow any origin.
DEMO_ALLOWED_ORIGINS=*
# Max audio duration allowed for demo uploads/recordings (seconds).
DEMO_MAX_AUDIO_DURATION_S=60
# Max upload size for demo (bytes). Default 25 MB.
DEMO_MAX_UPLOAD_BYTES=26214400
# Per-IP rate limit for demo endpoints (requests per minute).
DEMO_RATE_LIMIT_PER_MIN=10
