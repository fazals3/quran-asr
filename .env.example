# Example config for `quran-asr/` (no secrets).
#
# Copy to `.env` and adjust. Keep `.env` out of git.

TAILSCALE_IP=127.0.0.1
API_KEY=change_me
RUST_API_PORT=8001
RUST_API_LOCAL_PORT=8004

# If `false` (recommended behind Cloudflare), a valid `API_KEY` is sufficient even if the client IP
# is not in `ALLOW_CIDRS` (Cloudflare requests come from Cloudflare IPs).
ENFORCE_ALLOW_CIDRS_WITH_API_KEY=false

# Public streaming auth (Option B refresh):
# - iOS connects to inference WS with a short-lived stream JWT minted by the gateway.
# - The token is session-scoped via `sid` claim and admin-only via `role=admin`.
STREAM_JWT_SECRET=change_me_stream_jwt_secret
STREAM_JWT_AUDIENCE=inference_stream
STREAM_AUTH_GRACE_S=10
STREAM_NO_AUDIO_TIMEOUT_S=30
STREAM_SILENCE_DBFS_THRESHOLD=-45
STREAM_SILENCE_SKIP_AFTER_S=1.2
STREAM_SILENCE_TIMEOUT_S=60
STREAM_TAIL_CONTEXT_S=4.0
STREAM_FULL_REFRESH_EVERY_S=60.0

MAX_QUEUE_LENGTH=32
MAX_UPLOAD_BYTES=209715200
WORKER_CONCURRENCY=2

# Auto-clean `/data/jobs/<job_id>` directories.
# Completed/failed in-memory jobs are deleted after `JOB_RETENTION_S`.
# Leftover job dirs from previous API runs are deleted based on directory mtime.
JOB_CLEANUP_ENABLED=true
JOB_RETENTION_S=86400
JOB_CLEANUP_INTERVAL_S=3600
JOB_CLEANUP_STARTUP=true
JOB_CLEANUP_MAX_DELETE_PER_RUN=200

# Rust-side global GPU concurrency cap across all transcriber instances + streaming.
# On a single 8GB GPU, `2` is usually the best throughput/latency tradeoff.
RUST_TRANSCRIBE_MAX_INFLIGHT=2

MODEL_ID=OdyAsh/faster-whisper-base-ar-quran
LANGUAGE=ar
DEVICE=cuda
COMPUTE_TYPE=float16

# `1` is the fastest (greedy); `5` is more conservative (beam search).
BEAM_SIZE=1
PATIENCE=1.2
WORD_TIMESTAMPS=true
WHISPER_LOG_PROB_THRESHOLD=-0.15
WHISPER_NO_SPEECH_THRESHOLD=0.0

# Throughput tuning:
# - `BATCH_SIZE` is the default requested batch size.
# - `BATCH_SIZE_CAP` is a hard ceiling for per-request overrides; on CUDA OOM it ratchets down automatically.
BATCH_SIZE=32
BATCH_SIZE_CAP=128
MAX_CONCURRENT_TRANSCRIBES=1

# Transcription backend:
# - `batched` is faster but can occasionally drop text; we run a conservative repair pass to fill obvious holes.
# - `standard` uses `WhisperModel.transcribe` directly (slower, but simplest).
TRANSCRIBE_BACKEND=batched
TRANSCRIBE_ENABLE_REPAIR=true
TRANSCRIBE_REPAIR_MAX_WINDOWS=3
TRANSCRIBE_REPAIR_CONTEXT_S=3.0
TRANSCRIBE_REPAIR_GAP_TRIGGER_S=6.0
TRANSCRIBE_REPAIR_LOW_WORDS_DURATION_S=12.0
TRANSCRIBE_REPAIR_LOW_WORDS_MAX_WORDS=6


EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cuda
WARM_EMBEDDER=false

AYAH_ALIGN_MODE=v2
AYAH_ALIGN_V2_ASSETS_DIR=/data/alignment/v2
AYAH_WORD_TIME_UPGRADE=smooth
AYAH_ALIGN_V2_REF_DEL_COST_CAP=0.75
AYAH_ALIGN_V2_OBS_INS_COST_CAP=

QURAN_DB_PATH=/data/quran.db
GUESS_TOP_K=5
GUESS_PER_SURAH_TOP_N=3
GUESS_QUERY_OPERATOR=OR
GUESS_RANK_MODE=sum_top_score
GUESS_MAX_QUERY_TOKENS=24
GUESS_MAX_HITS=800
